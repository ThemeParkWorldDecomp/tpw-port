# The tpw-mods mods (platform/mods.h), included by CMakeLists.txt after tpw_platform is made, with the port's fixes only.
# TPW_MODS_DIR is a tpw-mods folder: tpw-mods next to this repository by default, mods/ (the submodule) in tpw-port. Its
# mods.cmake names each mod's folder with tpw_add_mod and its tests with tpw_add_mod_test. Each mod's mod.json is read
# here and checked, its sources go into tpw_platform, and the catalog of mods.h (Catalog()) is written into the build
# folder as mods_catalog.cpp. Without the folder the build has no mods, and the launcher's Mods box says so.
set(TPW_MODS_DIR ${CMAKE_CURRENT_SOURCE_DIR}/../tpw-mods CACHE PATH "The tpw-mods folder whose mods the launcher is built with")
# The hooks a mod.json may name (its "hooks"), each a TPW_MOD_HOOK comment in the game's code and a field of mods.h's Hooks.
set(TPW_MOD_HOOKS strike_gate strike_messages staff_bridge_wander ps1_badge ps1_ground ps1_save_repair ps1_pick_rotation tpi_worlds tpi_islands)
set_property(GLOBAL PROPERTY TPW_MOD_IDS)

# A string of mod.json as a C++ string literal.
function(_tpw_mod_literal text result)
  string(REPLACE "\\" "\\\\" text "${text}")
  string(REPLACE "\"" "\\\"" text "${text}")
  string(REPLACE "\n" "\\n" text "${text}")
  set(${result} "\"${text}\"" PARENT_SCOPE)
endfunction()

# The member `key` of mod.json's object, which must be of `type` (STRING, ARRAY or BOOLEAN).
function(_tpw_mod_member json file key type result)
  string(JSON value ERROR_VARIABLE err GET "${json}" ${key})
  if(err)
    message(FATAL_ERROR "${file}: no \"${key}\"")
  endif()
  string(JSON got TYPE "${json}" ${key})
  if(NOT got STREQUAL type)
    message(FATAL_ERROR "${file}: \"${key}\" is ${got}, not ${type}")
  endif()
  if(type STREQUAL "STRING" AND value STREQUAL "")
    message(FATAL_ERROR "${file}: \"${key}\" is empty")
  endif()
  set(${result} "${value}" PARENT_SCOPE)
endfunction()

# The strings of mod.json's array `key`.
function(_tpw_mod_strings json file key result)
  _tpw_mod_member("${json}" ${file} ${key} ARRAY array)
  string(JSON count LENGTH "${json}" ${key})
  set(items)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
      string(JSON item GET "${json}" ${key} ${i})
      string(JSON got TYPE "${json}" ${key} ${i})
      if(NOT got STREQUAL "STRING")
        message(FATAL_ERROR "${file}: \"${key}\" holds a ${got}, not only strings")
      endif()
      list(APPEND items ${item})
    endforeach()
  endif()
  set(${result} "${items}" PARENT_SCOPE)
endfunction()

# tpw_add_mod(<folder> SOURCES <file>...): the mod in TPW_MODS_DIR/<folder>, whose mod.json describes it and whose SOURCES
# (paths in its folder) define its switch-on function, tpw::mods::SwitchOn_<id, with _ for ->(Hooks&).
function(tpw_add_mod folder)
  cmake_parse_arguments(PARSE_ARGV 1 arg "" "" "SOURCES")
  set(dir ${TPW_MODS_DIR}/${folder})
  set(file ${dir}/mod.json)
  if(NOT EXISTS ${file})
    message(FATAL_ERROR "tpw_add_mod(${folder}): ${file} is missing")
  endif()
  if(NOT arg_SOURCES)
    message(FATAL_ERROR "tpw_add_mod(${folder}): no SOURCES")
  endif()
  set_property(DIRECTORY ${CMAKE_SOURCE_DIR} APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${file})
  file(READ ${file} json)
  string(JSON type ERROR_VARIABLE err TYPE "${json}")
  if(err OR NOT type STREQUAL "OBJECT")
    message(FATAL_ERROR "${file}: not a JSON object (${err})")
  endif()
  foreach(key id name version author license text)
    _tpw_mod_member("${json}" ${file} ${key} STRING ${key})
  endforeach()
  if(NOT id STREQUAL folder)
    message(FATAL_ERROR "${file}: \"id\" is ${id}, not its folder's name ${folder}")
  endif()
  if(NOT id MATCHES "^[a-z0-9]+(-[a-z0-9]+)*$")
    message(FATAL_ERROR "${file}: \"id\" ${id} is not lower case letters and digits joined by -")
  endif()
  if(NOT version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
    message(FATAL_ERROR "${file}: \"version\" ${version} is not X.Y.Z")
  endif()
  _tpw_mod_strings("${json}" ${file} editions editions)
  set(mask 0)
  foreach(edition ${editions})
    if(edition STREQUAL "US")
      math(EXPR mask "${mask} | 1")
    elseif(edition STREQUAL "European")
      math(EXPR mask "${mask} | 2")
    elseif(edition STREQUAL "Gold")
      math(EXPR mask "${mask} | 4")
    else()
      message(FATAL_ERROR "${file}: \"editions\" holds ${edition}, not US, European or Gold")
    endif()
  endforeach()
  if(mask EQUAL 0)
    message(FATAL_ERROR "${file}: \"editions\" is empty")
  endif()
  _tpw_mod_strings("${json}" ${file} conflicts conflicts)
  foreach(other ${conflicts})
    if(other STREQUAL id)
      message(FATAL_ERROR "${file}: \"conflicts\" names the mod itself")
    endif()
  endforeach()
  _tpw_mod_strings("${json}" ${file} hooks hooks)
  foreach(hook ${hooks})
    if(NOT hook IN_LIST TPW_MOD_HOOKS)
      message(FATAL_ERROR "${file}: \"hooks\" names ${hook}, which the port does not have (it has: ${TPW_MOD_HOOKS})")
    endif()
  endforeach()
  _tpw_mod_member("${json}" ${file} changes_saves BOOLEAN changes_saves)
  # "content" (optional): the folder of the launcher's data folder's assets that holds the mod's content, made from the
  # player's own disc (platform/content_overlay.h). The mod stays locked until that folder holds it.
  set(content "")
  string(JSON got ERROR_VARIABLE err TYPE "${json}" content)
  if(NOT err)
    _tpw_mod_member("${json}" ${file} content STRING content)
    if(NOT content MATCHES "^[a-z0-9]+(-[a-z0-9]+)*$")
      message(FATAL_ERROR "${file}: \"content\" ${content} is not lower case letters and digits joined by -")
    endif()
    if(content MATCHES "^(us|eur|gold|lang|us-pc|eur-pc|packs)$")
      message(FATAL_ERROR "${file}: \"content\" ${content} is a folder the launcher's importer keeps")
    endif()
    if(NOT changes_saves)
      message(FATAL_ERROR "${file}: a mod with \"content\" changes saved games (a park keeps the rides it uses)")
    endif()
  endif()
  get_property(ids GLOBAL PROPERTY TPW_MOD_IDS)
  if(id IN_LIST ids)
    message(FATAL_ERROR "${file}: mods.cmake adds ${id} twice")
  endif()
  set_property(GLOBAL APPEND PROPERTY TPW_MOD_IDS ${id})

  string(MAKE_C_IDENTIFIER "${id}" symbol)
  set(entry "    {")
  foreach(key id name version author license text)
    _tpw_mod_literal("${${key}}" literal)
    string(APPEND entry "${literal}, ")
  endforeach()
  string(APPEND entry "${mask}, {")
  foreach(other ${conflicts})
    _tpw_mod_literal("${other}" literal)
    string(APPEND entry "${literal}, ")
  endforeach()
  if(changes_saves)
    string(APPEND entry "}, true, {")
  else()
    string(APPEND entry "}, false, {")
  endif()
  foreach(hook ${hooks})
    string(APPEND entry "\"${hook}\", ")
  endforeach()
  _tpw_mod_literal("${content}" literal)
  string(APPEND entry "}, &SwitchOn_${symbol}, ${literal}},\n")
  set_property(GLOBAL APPEND_STRING PROPERTY TPW_MOD_ENTRIES "${entry}")
  set_property(GLOBAL APPEND_STRING PROPERTY TPW_MOD_DECLARATIONS "void SwitchOn_${symbol}(Hooks& hooks);\n")

  set(sources)
  foreach(source ${arg_SOURCES})
    list(APPEND sources ${dir}/${source})
  endforeach()
  set_property(GLOBAL PROPERTY TPW_MOD_${symbol}_SOURCES ${sources})
  target_sources(tpw_platform PRIVATE ${sources})
  message(STATUS "tpw: mod ${id} ${version} (${TPW_MODS_DIR}/${folder})")
endfunction()

# tpw_add_mod_test(<folder> NAME <name> SOURCES <file>... [GAME <path under src/>... KEEP <definition>...]): a test program
# of the mod in TPW_MODS_DIR/<folder> (added before with tpw_add_mod), run by ctest as mod_<name>. It is built from its
# SOURCES (paths in the mod's folder), the mod's own sources and platform/mods.cpp, not from the launcher's libraries:
# the GAME files of the translation are compiled in, cut to the KEEP definitions (the slicer, cmake/slicer.cmake), and the
# test defines what they call. Not made where the platform tests are not (no libclang for the slicer).
function(tpw_add_mod_test folder)
  cmake_parse_arguments(PARSE_ARGV 1 arg "" "NAME" "SOURCES;GAME;KEEP")
  string(MAKE_C_IDENTIFIER "${folder}" symbol)
  get_property(mod_sources GLOBAL PROPERTY TPW_MOD_${symbol}_SOURCES)
  if(NOT mod_sources)
    message(FATAL_ERROR "tpw_add_mod_test(${folder}): tpw_add_mod(${folder}) comes first")
  endif()
  if(NOT arg_NAME OR NOT arg_SOURCES)
    message(FATAL_ERROR "tpw_add_mod_test(${folder}): give NAME and SOURCES")
  endif()
  set(target tpw_mod_test_${arg_NAME})
  set(sources)
  foreach(source ${arg_SOURCES})
    list(APPEND sources ${TPW_MODS_DIR}/${folder}/${source})
  endforeach()
  add_executable(${target} ${sources} ${mod_sources} ${CMAKE_CURRENT_SOURCE_DIR}/platform/mods.cpp)
  target_include_directories(${target} PRIVATE ${TPW_INCLUDE_DIR} ${CMAKE_CURRENT_SOURCE_DIR}/platform ${TPW_DECOMP_DIR}/platform)
  target_compile_options(${target} PRIVATE -Wno-invalid-offsetof)   # the game's headers check their layouts with offsetof
  if(arg_GAME)
    set(game)
    foreach(path ${arg_GAME})
      list(APPEND game ${TPW_DECOMP_DIR}/src/${path})
    endforeach()
    target_sources(${target} PRIVATE ${game})
    tpw_slice(TARGET ${target} NAME mod_${arg_NAME} KEEP ${arg_KEEP} SOURCES ${arg_GAME})
  endif()
  add_test(NAME mod_${arg_NAME} COMMAND ${target})
  get_target_property(excluded tpw_platform_tests EXCLUDE_FROM_ALL)
  if(excluded)
    set_target_properties(${target} PROPERTIES EXCLUDE_FROM_ALL ON)
    set_tests_properties(mod_${arg_NAME} PROPERTIES DISABLED ON)
  endif()
endfunction()

set_property(GLOBAL PROPERTY TPW_MOD_ENTRIES "")
set_property(GLOBAL PROPERTY TPW_MOD_DECLARATIONS "")
if(EXISTS ${TPW_MODS_DIR}/mods.cmake)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${TPW_MODS_DIR}/mods.cmake)
  include(${TPW_MODS_DIR}/mods.cmake)
else()
  message(STATUS "tpw: no mods (no mods.cmake in ${TPW_MODS_DIR})")
endif()
get_property(entries GLOBAL PROPERTY TPW_MOD_ENTRIES)
get_property(declarations GLOBAL PROPERTY TPW_MOD_DECLARATIONS)
file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/mods_catalog.cpp.new
     "// Written by platform/mods.cmake from ${TPW_MODS_DIR}/mods.cmake: the catalog of mods.h.\n"
     "#include \"mods.h\"\n\nnamespace tpw::mods {\n\n${declarations}\n"
     "const std::vector<Mod>& Catalog() {\n    static const std::vector<Mod> catalog = {\n${entries}    };\n"
     "    return catalog;\n}\n\n}  // namespace tpw::mods\n")
configure_file(${CMAKE_CURRENT_BINARY_DIR}/mods_catalog.cpp.new ${CMAKE_CURRENT_BINARY_DIR}/mods_catalog.cpp COPYONLY)
target_sources(tpw_platform PRIVATE ${CMAKE_CURRENT_BINARY_DIR}/mods_catalog.cpp)
