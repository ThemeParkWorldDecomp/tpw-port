<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- UTF-8 as the process's code page (Windows 10 1903 and later; older ones ignore it): the program's narrow paths, argv and
     fopen then hold every player's name. Nothing else is set: the program behaves as it did without a manifest.
     See launcher/win/launcher.rc.in and platform/path_text.h. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="TPW.Launcher" version="1.0.0.0"/>
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
