<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The launcher's Info.plist. CMakeLists.txt fills the @...@ names: the version from launcher/VERSION.txt, the names from
     the same words as launcher/ui/theme.h. The bare tpw_launcher carries it embedded (the linker's -sectcreate __TEXT
     __info_plist): that names the program in Cmd-Tab and Force Quit (CFBundleName) and gives it its identifier, and it is the
     plist the launcher writes into the application bundle it makes beside itself and runs from (launcher/app_bundle.h),
     which names it in the Dock. With the CMake option TPW_BUNDLE (off by default) it is the built bundle's Info.plist
     instead. The display name carries no version: the Dock says "STP/TPW Launcher" (the maintainer, 2026-10-25). The menu bar's
     application menu is named at run time (launcher/main.cpp NameAppMenu). -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>@TPW_BUNDLE_EXECUTABLE@</string>
	<key>CFBundleIdentifier</key>
	<string>@TPW_BUNDLE_IDENTIFIER@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>@TPW_BUNDLE_NAME@</string>
	<key>CFBundleDisplayName</key>
	<string>@TPW_BUNDLE_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@TPW_LAUNCHER_VERSION_NUMBER@</string>
	<key>CFBundleVersion</key>
	<string>@TPW_LAUNCHER_VERSION_NUMBER@</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
</dict>
</plist>
